# ScaleApp — variáveis de ambiente (copie para .env e ajuste).
# NUNCA comitar o .env real.

# --- Postgres ---
POSTGRES_USER=scaleapp
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=scaleapp
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Conexão usada pela API e pelas migrations ---
# Aponta para os serviços do docker-compose expostos em localhost.
DATABASE_URL=postgres://scaleapp:change-me-in-.env@localhost:5432/scaleapp
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0

# --- Worker (Fase 03) ---
WORKER_ID=worker-1
WORKER_CONCURRENCY=5
# Classes de driver que este worker processa (csv). Default: graph_api.
# WORKER_DRIVER_CLASSES=graph_api,playwright,content_acquisition
LOG_LEVEL=info

# --- Driver Graph API (Fase 06) ---
# Usa o driver Graph API real para graph_api (senão, driver mock). Default off.
# Requer token/proxy/mídia resolvíveis (stubs de dev abaixo) — ainda NÃO posta
# de verdade sem credenciais reais e os módulos de Sessão/Proxy/Mídia.
# WORKER_GRAPH_DRIVER=1
# Token de dev usado quando access_token_ref é um ponteiro de cofre (vault://).
# GRAPH_DEV_TOKEN=
# Credenciais de dev do proxy (user:pass) quando não vêm do cofre.
# GRAPH_DEV_PROXY_AUTH=

# --- Cofre de segredos / Sessão (módulo 8) ---
# Chaves do cofre: "id:base64(32 bytes)", separadas por vírgula. SEM ela não há
# criptografia em repouso: worker cai nos stubs de dev e as rotas de sessão da
# API respondem 503. Gerar uma chave:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECRETS_KEYS=k1:troque-por-uma-chave-base64-de-32-bytes
# Qual chave cifra os segredos novos (default: a última declarada). Para
# rotacionar: acrescente k2 em SECRETS_KEYS, aponte SECRETS_ACTIVE_KEY pra ela e
# mantenha k1 na lista até a rotação das linhas antigas terminar.
# SECRETS_ACTIVE_KEY=k1

# Callback do OAuth — tem que bater byte a byte com a URI cadastrada no Meta App.
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

# Varredura de refresh preventivo (regra 6). Ligue em UM worker só.
# SESSION_SWEEP_ENABLED=1
# Antecedência do refresh (default 7 dias; token longo do IG dura 60).
# SESSION_REFRESH_WITHIN_MS=604800000
# Intervalo entre varreduras — também o teto do stagger (regra 5).
# SESSION_SWEEP_INTERVAL_MS=900000
# Teto de contas por varredura (regra 8).
# SESSION_SWEEP_LIMIT=200
# Espera mínima antes de tentar de novo a mesma conta / desistência.
# SESSION_MIN_RETRY_INTERVAL_MS=3600000
# SESSION_MAX_REFRESH_FAILURES=5
# TTL do cache de token decifrado no worker (0 desliga).
# SESSION_TOKEN_CACHE_TTL_MS=30000

# --- Pool de proxies (módulo 9) ---
# Varredura de saúde do pool. Ligue em UM worker só.
# PROXY_SWEEP_ENABLED=1
# Alvo da sonda: precisa devolver o IP de saída (texto ou JSON {"ip":...}).
# PROXY_PROBE_URL=https://api.ipify.org?format=json
# PROXY_PROBE_TIMEOUT_MS=10000
# Intervalo entre varreduras (teto do espaçamento das sondas — regra 5).
# PROXY_SWEEP_INTERVAL_MS=600000
# Teto de proxies por varredura (regra 8) e idade que torna a checagem velha.
# PROXY_SWEEP_LIMIT=100
# PROXY_STALE_AFTER_MS=1800000
# Falhas seguidas para declarar um proxy morto.
# PROXY_DOWN_AFTER_FAILURES=3
# Suspeita de outage do provedor: exige os DOIS limiares (regra 2). Enquanto a
# suspeita vale, nenhum proxy é marcado down — só degradado.
# PROXY_OUTAGE_RATIO=0.5
# PROXY_OUTAGE_MIN_COUNT=5
# Troca automática de proxy da conta após N falhas seguidas. 0 = desligado
# (default: trocar de IP sozinho é justamente o que a plataforma nota).
# PROXY_SWAP_AFTER_FAILURES=0
# Aviso de pool perto de acabar.
# PROXY_LOW_POOL_THRESHOLD=5
# TTL do cache de URL de proxy no worker (0 desliga).
# PROXY_RESOLVER_CACHE_TTL_MS=60000

# --- Observabilidade (Fase 05) ---
# Porta do endpoint /metrics do worker (a API expõe /metrics na própria API_PORT).
WORKER_METRICS_PORT=9101
# Envio de logs pino ao Loki (opt-in). Sem esta var, logs vão só pro stdout.
# Com a stack do compose no ar: http://localhost:3100
# LOKI_URL=http://localhost:3100

# Stack de monitoramento (profile "observability" do compose).
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
