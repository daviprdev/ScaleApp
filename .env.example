# ScaleApp — variáveis de ambiente (copie para .env e ajuste).
# NUNCA comitar o .env real.

# --- Postgres ---
POSTGRES_USER=scaleapp
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=scaleapp
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Conexão usada pela API e pelas migrations ---
# Aponta para os serviços do docker-compose expostos em localhost.
DATABASE_URL=postgres://scaleapp:change-me-in-.env@localhost:5432/scaleapp
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0

# --- Worker (Fase 03) ---
WORKER_ID=worker-1
WORKER_CONCURRENCY=5
# Classes de driver que este worker processa (csv). Default: graph_api.
# WORKER_DRIVER_CLASSES=graph_api,playwright,content_acquisition
LOG_LEVEL=info
